<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <!-- Test only the linked production units, without loading the entire WinForms application. -->
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    </PropertyGroup>
    <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
    <PropertyGroup>
        <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
        <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
        <OutputType>Exe</OutputType>
        <AssemblyName>TS-SE-Tool.RegressionTests</AssemblyName>
        <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
        <OutputPath>bin\$(Configuration)\</OutputPath>
        <LangVersion>latest</LangVersion>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <Deterministic>true</Deterministic>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="System" />
        <Reference Include="System.Core" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Web.Extensions" />
        <Reference Include="System.Windows.Forms" />
        <Compile Include="RegressionTests.cs" />
        <Compile Include="TestSupport.cs" />
        <Compile Include="..\..\TS SE Tool\CustomClasses\Utilities\AtomicFile.cs"><Link>AtomicFile.cs</Link></Compile>
        <Compile Include="..\..\TS SE Tool\CustomClasses\Program\ProgSettings.cs"><Link>ProgSettings.cs</Link></Compile>
        <Compile Include="..\..\TS SE Tool\CustomClasses\Updates\GitHubReleaseClient.cs"><Link>GitHubReleaseClient.cs</Link></Compile>
        <Compile Include="..\..\TS SE Tool\CustomClasses\Updates\AutoUpdateService.cs"><Link>AutoUpdateService.cs</Link></Compile>
    </ItemGroup>
    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
