<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
        <PlatformTarget>x86</PlatformTarget>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishTrimmed>false</PublishTrimmed>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <RootNamespace>TS_SE_Tool</RootNamespace>
        <AssemblyName>TS SE Tool</AssemblyName>
        <ApplicationIcon>Resources\MainIco.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
        <PackageReference Include="System.Resources.Extensions" Version="10.0.12" />
        <None Remove="SII_Decrypt.dll" />
        <Content Include="SII_Decrypt.dll" Link="libs\SII_Decrypt.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="libs\SII_Decrypt.dll" />
    </ItemGroup>
</Project>
