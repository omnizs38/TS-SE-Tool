<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System.Configuration.ConfigurationManager">
      <section name="TS_SE_Tool.Properties.Settings" type="System.Configuration.ClientSettingsSection, System.Configuration.ConfigurationManager" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <userSettings>
    <TS_SE_Tool.Properties.Settings>
      <setting name="ShowSplashOnStartup" serializeAs="String"><value>True</value></setting>
      <setting name="CheckUpdatesOnStartup" serializeAs="String"><value>True</value></setting>
      <setting name="AutoInstallUpdates" serializeAs="String"><value>True</value></setting>
    </TS_SE_Tool.Properties.Settings>
  </userSettings>
</configuration>
